# --- Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Leave unset for local dev (SQLite file db.sqlite3). Set it on the server:
# DATABASE_URL=postgres://gym:gym@localhost:5432/gym
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# --- Media on S3 (AWS, MinIO, ArvanCloud, Liara… any S3-compatible store)
USE_S3=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=gym-guy
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_S3_CUSTOM_DOMAIN=
AWS_QUERYSTRING_AUTH=false
